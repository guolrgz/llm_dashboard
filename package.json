{
  "name": "llm-token-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LLM 推理 · Token 流量管理系统（Vue 3 + Vite 控制台 + FastAPI/SQLite 后端）",
  "scripts": {
